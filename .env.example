# Jarvis Environment Configuration
# Copy this file to .env and fill in the values for your setup.
#
#   cp .env.example .env
#
# All variables use the JARVIS_ prefix and map to JarvisConfig fields
# in src/jarvis/config/settings.py via pydantic-settings.
#
# Local development requires real provider keys (OPENAI_API_KEY for the
# default openai-compatible reasoner, plus GOOGLE_API_KEY / ANTHROPIC_API_KEY
# if you exercise the frontier-escape paths). The test suite ships its own
# obviously-fake stub via tests/conftest.py and never reaches the wire, so
# `pytest tests/` runs cleanly with no env configuration.

# ---- Supervisor model (provider:model format) ----
# Default routes through llama-swap on the local GB10.
# Examples: openai:jarvis-reasoner, anthropic:claude-sonnet-4-20250514, google_genai:gemini-2.0-flash
JARVIS_SUPERVISOR_MODEL=openai:jarvis-reasoner

# ---- Logging level ----
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
JARVIS_LOG_LEVEL=INFO

# ---- Memory store backend ----
# Phase 1 supports: in_memory
# Future: file
JARVIS_MEMORY_STORE_BACKEND=in_memory

# ---- Provider API keys (uncomment the one you need) ----
# JARVIS_ANTHROPIC_API_KEY=sk-ant-...
# JARVIS_OPENAI_API_KEY=sk-...
# JARVIS_GOOGLE_API_KEY=AIza...

# ---- Tavily web-search API key ----
# Read by `search_web` (src/jarvis/tools/general.py) when
# `web_search_provider=tavily` (the default). This field reads the
# un-prefixed `TAVILY_API_KEY` — the env name the langchain-tavily SDK
# uses natively — so the same value works for the underlying SDK and
# JarvisConfig.tavily_api_key. Falls back to JARVIS_TAVILY_API_KEY.
# Without this set, `search_web` returns
# `ERROR: config_missing — tavily_api_key not set in JarvisConfig`.
# TAVILY_API_KEY=tvly-...

# ===========================================================================
# FEAT-JARVIS-003 — Async-subagent routing + attended frontier escape
# ===========================================================================

# ---- llama-swap base URL ----
# Endpoint of the local llama-swap process on the GB10 box (ADR-ARCH-012).
# The swap-aware supervisor and the `jarvis-reasoner` AsyncSubAgent both
# route through this URL. Per ADR-ARCH-001 (local-first inference), this
# is the ONLY supported supervisor endpoint — cloud OpenAI is not a
# supported supervisor target. ``src/jarvis/infrastructure/lifecycle.py``
# unconditionally exports ``OPENAI_BASE_URL=<this>/v1`` at startup so the
# ``openai:`` provider prefix in ``JARVIS_SUPERVISOR_MODEL`` resolves to
# llama-swap, not ``api.openai.com``.
JARVIS_LLAMA_SWAP_BASE_URL=http://promaxgb10-41b1:9000

# ---- Frontier escalation default target ----
# Default cloud model used by `escalate_to_frontier` when the caller does
# not specify `target=` (ADR-ARCH-027). Allowed: GEMINI_3_1_PRO, OPUS_4_7.
# JARVIS_FRONTIER_DEFAULT_TARGET=GEMINI_3_1_PRO

# ---- Gemini frontier API key ----
# Required when `escalate_to_frontier` is invoked with target=GEMINI_3_1_PRO.
# This field reads the un-prefixed `GOOGLE_API_KEY` (the Google GenAI SDK's
# native env name) so the same value works for the underlying SDK and
# JarvisConfig.gemini_api_key. Falls back to JARVIS_GEMINI_API_KEY.
# GOOGLE_API_KEY=AIza...

# ---- Attended adapter ids ----
# Comma/JSON-set of adapter IDs that count as "attended" consumer surfaces;
# `escalate_to_frontier` is constitutionally gated to these adapters only
# (ADR-ARCH-016). Defaults to {telegram, cli, dashboard, reachy} — override
# only if you ship a new attended adapter.
# JARVIS_ATTENDED_ADAPTER_IDS='["telegram","cli","dashboard","reachy"]'

# ===========================================================================
# FEAT-JARVIS-004 — Fleet registration + specialist dispatch
# ===========================================================================
# All values below are OPTIONAL — defaults in src/jarvis/config/settings.py
# yield a working zero-env developer setup. See
# docs/design/FEAT-JARVIS-004/contracts/API-internal.md §8 for the contract.

# ---- NATS broker URL ----
# Endpoint for the NATS JetStream broker that carries fleet registration,
# heartbeat, and dispatch traffic. Defaults to the localhost in-process
# broker used by the integration test pattern.
# JARVIS_NATS_URL=nats://localhost:4222

# ---- NATS credentials path ----
# Optional path to a NATS .creds file. Leave unset for an anonymous /
# dev broker. Production deployments set this to the operator-provisioned
# credentials file.
# JARVIS_NATS_CREDENTIALS_PATH=/etc/jarvis/nats.creds

# ---- NATS user / password ----
# Optional username + password for user/password NATS accounts (the fleet
# broker's auth model, as distinct from an NKey .creds file). Set BOTH to
# authenticate without embedding the password inline in JARVIS_NATS_URL
# (nats://user:pass@host). Shared by the supervisor connect AND the
# fleet-memory publisher below. Both must be non-blank to take effect: a lone
# user or password, a blank value (leaving these keys as `KEY=`), or setting
# them alongside JARVIS_NATS_CREDENTIALS_PATH all fall back to the URL /
# creds-file / anonymous auth path — the .creds file wins when both are set.
# JARVIS_NATS_USER=jarvis
# JARVIS_NATS_PASSWORD=change-me

# ---- Heartbeat interval (seconds) ----
# Fleet heartbeat cadence per DDR-021/heartbeat. Constrained to 5..300.
# JARVIS_HEARTBEAT_INTERVAL_SECONDS=30

# ---- Fleet-memory (routing-history writes) ----
# Master switch for publishing routing-history telemetry to the fleet-memory
# store (as ``document`` episodes over NATS). Leave unset / false to exercise
# the DDR-019 soft-fail path (entries offloaded to JARVIS_TRACES_DIR instead of
# published). The un-prefixed FLEET_MEMORY_ENABLED is honoured too, for
# fleet-wide consistency. The write path reuses the NATS endpoint + credentials
# above — no separate memory NATS identity is required.
# JARVIS_FLEET_MEMORY_ENABLED=false

# ---- Fleet-memory project ----
# Project namespace this Jarvis instance writes under
# (memory.episode.{project}.{type} subject + natural-key prefix). The
# un-prefixed FLEET_MEMORY_PROJECT is honoured too. Defaults to "jarvis".
# JARVIS_FLEET_MEMORY_PROJECT=jarvis

# ---- Local traces directory ----
# Directory used for offloaded routing-history payloads when the fleet-memory
# write path soft-fails (disabled or unreachable). Defaults to ~/.jarvis/traces.
# Autocreated on first soft-fail write per TASK-FRR-003 — no need to
# pre-provision; if creation fails (e.g. unwritable parent), the
# routing-history writer logs ``routing_history_offload_failed`` with
# both the memory-backend and local-write errors instead of silently
# dropping the trace.
# JARVIS_TRACES_DIR=/var/lib/jarvis/traces

# ---- Specialist dispatch timeout (seconds) ----
# Per-call timeout for specialist dispatch per DDR-016. Constrained to
# 5..600.
# JARVIS_SPECIALIST_DISPATCH_TIMEOUT_SECONDS=60

# ---- Concurrent dispatch cap ----
# Maximum number of concurrent specialist dispatches per DDR-020.
# Constrained to 1..64.
# JARVIS_DISPATCH_CONCURRENT_CAP=8

# ---- Jarvis agent version ----
# Semver string emitted on heartbeat / registration frames. Defaults to
# the current FEAT-JARVIS-004 release version.
# JARVIS_AGENT_VERSION=0.4.0

# Slack notification bridge (FEAT-UBS-003)
JARVIS_SLACK_BOT_TOKEN=xoxb-your-bot-token
JARVIS_SLACK_CHANNEL_ID=C0000000000
JARVIS_SLACK_APP_TOKEN=xapp-your-app-token
JARVIS_SLACK_OPERATOR_USER_ID=U0000000000
# decided_by identity published on ApprovalResponsePayload (TASK-JNB-104).
# Must string-equal forge's expected_approver VERBATIM — a mismatch silently
# refuses every phone approval. Aligned at TASK-JNB-107 live validation.
# Currently pinned value: rich (forge ApprovalConfig.expected_approver default,
# set by TASK-JNB-101 e003201 — NOT "rich-slack-operator"). Re-confirm against
# live forge config before a run; "rich" is only the default.
JARVIS_SLACK_DECIDED_BY=your-approver-identity

# Slack planning intake (FEAT-SPL-001, TASK-SPL-J02)
# The dedicated planning channel (#factory-planning) and the member id(s)
# authorized to originate planning requests (comma-separated allow-list-ready;
# v1 is operated as a single id — James for the exemplar, Rich for
# pre-exemplar testing). Both unset => planning intake is a logged no-op;
# planning config never affects the approval reply path and vice versa
# (union gate). OPERATOR PREREQUISITES (bundle with OPS-001, validated at
# TASK-SPL-J04): the Slack app manifest needs the message.channels AND
# message.groups bot event subscriptions (private channels deliver via
# message.groups only), and the bot must be /invite'd to the channel.
# Note: queued planning requests expire at the PIPELINE stream's 7d/10k
# work-retention bound until forge Mode P (FEAT-SPL-002) consumes them.
JARVIS_SLACK_PLANNING_CHANNEL_ID=C0000000000
JARVIS_SLACK_PLANNING_ORIGINATOR_USER_ID=U0000000000
