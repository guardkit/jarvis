{"message_id":"3ca0a6eb-a70a-41da-811a-d09dad1f27c5","timestamp":"2026-05-08T17:04:15.696184Z","version":"1.0","source_id":"jarvis","event_type":"command","project":null,"correlation_id":"31a2e8de-ab50-4758-8b09-23b3a31952d5","payload":{"command":"architect_align","args":{"adr_id":"ADR-ARCH-001","adr_summary":"Jarvis commits to local-first inference via llama-swap. Cloud LLMs are explicitly out of the supervisor hot path. All reasoning must run locally.","proposal_summary":"Add a Claude Opus 4.7 escalation tool that the supervisor can call when its local reasoner has low confidence on safety-critical or high-stakes user requests, bound by a per-session budget cap.","context":"The proposal introduces cloud LLM (Claude Opus 4.7) as an escalation path for the supervisor when local confidence is low on safety-critical or high-stakes requests. This is bound by a per-session budget cap. The key tension: ADR-ARCH-001 says cloud LLMs are out of the supervisor hot path. The proposal wants to put cloud back into the supervisor decision path under certain conditions."},"correlation_id":"31a2e8de-ab50-4758-8b09-23b3a31952d5"}}
